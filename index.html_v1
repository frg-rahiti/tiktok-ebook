<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Des guides numériques exigeants sur les prompts IA, le copywriting et la création de business en ligne. Paiement sécurisé, accès immédiat.">
<link rel="icon" type="image/x-icon" href="hitebook.ico">
<title>Hit-E-Book — Collection</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,450&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root{
        --bg: #0a0d16;
        --bg-panel: #12162389;
        --panel-solid: #12161f;
        --panel-raised: #171c29;
        --gold: #c9a24b;
        --gold-light: #e6c877;
        --gold-dim: rgba(201,162,75,0.22);
        --hairline: rgba(201,162,75,0.16);
        --cream: #f3ede0;
        --muted: #8991a6;
        --muted-dim: #5b6478;
        --green: #7fae8f;
    }

    *{ margin:0; padding:0; box-sizing:border-box; }

    html{ scroll-behavior:smooth; }

    body{
        font-family:'Inter', sans-serif;
        background:
            radial-gradient(1100px 600px at 50% -10%, rgba(201,162,75,0.10), transparent 60%),
            var(--bg);
        color: var(--cream);
        line-height:1.6;
        -webkit-font-smoothing: antialiased;
    }

    body::before{
        content:"";
        position:fixed; inset:0;
        pointer-events:none;
        opacity:0.05;
        z-index:1;
        background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }

    .container{ max-width:1180px; margin:0 auto; padding:0 24px; position:relative; z-index:2; }

    a{ color:inherit; }

    ::selection{ background: var(--gold-dim); color:var(--cream); }

    /* ============ TOP BAR ============ */
    .topbar{
        border-bottom:1px solid var(--hairline);
        padding:18px 0;
        position:sticky;
        top:0;
        background: rgba(10,13,22,0.86);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        z-index:50;
    }
    .topbar .container{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        flex-wrap:wrap;
    }
    .brand-mark{
        font-family:'Fraunces', serif;
        font-size:15px;
        letter-spacing:0.14em;
        text-transform:uppercase;
        color: var(--muted);
    }
    .brand-mark strong{ color: var(--gold-light); font-weight:600; }

    .topbar-right{
        display:flex;
        align-items:center;
        gap:22px;
    }

    .topbar-cta{
        font-family:'Inter', sans-serif;
        font-size:12px;
        font-weight:600;
        letter-spacing:0.06em;
        text-transform:uppercase;
        color: var(--gold-light);
        border:1px solid var(--gold-dim);
        padding:9px 18px;
        text-decoration:none;
        transition: all 0.25s ease;
        white-space:nowrap;
    }
    .topbar-cta:hover{ background: var(--gold); color:#0a0d16; border-color: var(--gold); }

    .language-selector{
        display:flex;
        align-items:center;
        gap:0;
    }
    .language-btn{
        background:none;
        border:none;
        color: var(--muted-dim);
        padding:6px 12px;
        cursor:pointer;
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.08em;
        text-transform:uppercase;
        border-right:1px solid var(--hairline);
        transition: color 0.25s ease;
    }
    .language-selector .language-btn:last-child{ border-right:none; }
    .language-btn:hover{ color: var(--gold-light); }
    .language-btn.active{ color: var(--gold); font-weight:600; }

    /* ============ HEADER / HERO ============ */
    header{
        padding:88px 20px 40px;
        text-align:center;
        border-bottom:1px solid var(--hairline);
        position:relative;
        overflow:hidden;
    }

    .eyebrow{
        display:inline-flex;
        align-items:center;
        gap:10px;
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.22em;
        text-transform:uppercase;
        color: var(--gold);
        margin-bottom:28px;
    }
    .eyebrow::before, .eyebrow::after{
        content:"";
        width:28px; height:1px;
        background: var(--gold-dim);
    }

    header h1{
        font-family:'Fraunces', serif;
        font-weight:450;
        font-size:clamp(44px, 7vw, 76px);
        letter-spacing:-0.01em;
        line-height:1.02;
        margin-bottom:22px;
    }

    .gradient-text{
        font-style:italic;
        font-weight:450;
        background: linear-gradient(135deg, var(--gold-light), var(--gold) 60%, #a5813a);
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
        background-clip:text;
    }

    header p{
        font-size:17px;
        color: var(--muted);
        max-width:480px;
        margin:0 auto 40px;
        font-weight:400;
    }

    .header-cta{
        display:inline-flex;
        align-items:center;
        gap:10px;
        background: var(--gold);
        color:#0a0d16;
        border:1px solid var(--gold);
        padding:15px 30px;
        text-align:center;
        font-family:'Inter', sans-serif;
        font-weight:600;
        font-size:13px;
        letter-spacing:0.08em;
        text-transform:uppercase;
        text-decoration:none;
        cursor:pointer;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        margin-bottom:40px;
    }
    .header-cta:hover{ transform: translateY(-2px); box-shadow: 0 12px 30px -8px rgba(201,162,75,0.45); }

    /* trust bar */
    .trust-bar{
        display:flex;
        justify-content:center;
        gap:36px;
        flex-wrap:wrap;
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.04em;
        color: var(--muted-dim);
    }
    .trust-bar span{
        display:inline-flex;
        align-items:center;
        gap:8px;
    }
    .trust-bar span::before{
        content:"";
        width:5px; height:5px;
        border-radius:50%;
        background: var(--gold);
        flex-shrink:0;
    }

    /* ============ HERO STRIP ============ */
    .hero{
        padding:52px 20px 44px;
        text-align:center;
    }

    .hero h2{
        font-family:'Fraunces', serif;
        font-weight:450;
        font-style:italic;
        font-size:clamp(26px, 3.4vw, 34px);
        color: var(--cream);
        margin-bottom:14px;
    }

    .hero p{
        font-size:15px;
        color: var(--muted);
        margin-bottom:44px;
    }

    .filters{
        display:flex;
        justify-content:center;
        gap:36px;
        flex-wrap:wrap;
        border-bottom:1px solid var(--hairline);
        padding-bottom:0;
    }

    .filter-btn{
        background:none;
        border:none;
        color: var(--muted-dim);
        padding:0 0 16px;
        cursor:pointer;
        font-family:'Inter', sans-serif;
        font-size:13px;
        letter-spacing:0.04em;
        text-transform:uppercase;
        font-weight:500;
        position:relative;
        transition: color 0.25s ease;
    }
    .filter-btn::after{
        content:"";
        position:absolute;
        left:0; right:0; bottom:-1px;
        height:2px;
        background: var(--gold);
        transform: scaleX(0);
        transform-origin:center;
        transition: transform 0.3s ease;
    }
    .filter-btn:hover{ color: var(--cream); }
    .filter-btn.active{ color: var(--gold-light); }
    .filter-btn.active::after{ transform: scaleX(1); }

    /* ============ PRODUCTS GRID ============ */
    .products-grid{
        display:grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap:1px;
        background: var(--hairline);
        border:1px solid var(--hairline);
        margin:64px 0 0;
    }

    .product-card{
        background: var(--panel-solid);
        position:relative;
        display:flex;
        flex-direction:column;
        transition: background 0.35s ease;
    }
    .product-card:hover{ background:#151a26; }

    .product-edition{
        position:absolute;
        top:22px; right:24px;
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.1em;
        color: var(--muted-dim);
        z-index:3;
    }

    .product-badge{
        position:absolute;
        top:22px; left:0;
        background: var(--gold);
        color:#0a0d16;
        font-family:'JetBrains Mono', monospace;
        font-size:10px;
        font-weight:700;
        letter-spacing:0.08em;
        text-transform:uppercase;
        padding:5px 12px 5px 14px;
        z-index:3;
    }

    .product-image{
        width:100%;
        height:380px;
        background: linear-gradient(180deg, #1b2130 0%, #0e1119 100%);
        display:flex;
        align-items:center;
        justify-content:center;
        overflow:hidden;
        position:relative;
    }
    .product-image::after{
        content:"";
        position:absolute; inset:0;
        background: linear-gradient(180deg, transparent 55%, rgba(10,13,22,0.55));
        pointer-events:none;
    }
    .product-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        filter: saturate(0.94) contrast(1.02);
        transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
    }
    .product-card:hover .product-image img{ transform: scale(1.045); }

    .product-content{
        padding:34px 32px 32px;
        flex:1;
        display:flex;
        flex-direction:column;
    }

    .product-category{
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.14em;
        text-transform:uppercase;
        color: var(--gold);
        margin-bottom:16px;
    }

    .product-title{
        font-family:'Fraunces', serif;
        font-weight:500;
        font-size:26px;
        line-height:1.2;
        margin-bottom:14px;
        color: var(--cream);
    }

    .product-desc{
        font-size:14px;
        color: var(--muted);
        margin-bottom:24px;
        line-height:1.65;
    }

    .product-features{
        list-style:none;
        margin-bottom:26px;
        border-top:1px solid var(--hairline);
        padding-top:18px;
    }

    .product-features li{
        font-size:13px;
        color:#aab2c5;
        padding:8px 0;
        display:flex;
        gap:12px;
        align-items:baseline;
        border-bottom:1px solid rgba(201,162,75,0.08);
    }
    .product-features li:last-child{ border-bottom:none; }

    .product-features li:before{
        content:"◆";
        color: var(--gold);
        font-size:6px;
        flex-shrink:0;
        transform: translateY(-2px);
    }

    .product-price{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        margin-bottom:16px;
        padding-top:20px;
        margin-top:auto;
        border-top:1px solid var(--hairline);
    }

    .price-tag{
        font-family:'Fraunces', serif;
        font-size:30px;
        font-weight:500;
        color: var(--gold-light);
        line-height:1;
    }
    .price-tag .currency{
        font-size:16px;
        font-family:'Inter', sans-serif;
        vertical-align: super;
        margin-right:2px;
        color: var(--gold);
    }

    .price-note{
        font-family:'JetBrains Mono', monospace;
        font-size:10px;
        letter-spacing:0.08em;
        text-transform:uppercase;
        color: var(--muted-dim);
    }

    .product-guarantee{
        font-family:'JetBrains Mono', monospace;
        font-size:10.5px;
        letter-spacing:0.03em;
        color: var(--green);
        margin-bottom:14px;
        display:flex;
        align-items:center;
        gap:7px;
    }
    .product-guarantee::before{ content:"✓"; }

    .product-cta{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;
        background:transparent;
        color: var(--gold-light);
        border:1px solid var(--gold);
        padding:14px 24px;
        text-align:center;
        font-family:'Inter', sans-serif;
        font-weight:600;
        font-size:12px;
        letter-spacing:0.1em;
        text-transform:uppercase;
        text-decoration:none;
        cursor:pointer;
        width:100%;
        transition: background 0.3s ease, color 0.3s ease;
    }
    .product-cta .arrow{ transition: transform 0.3s ease; }
    .product-cta:hover{
        background: var(--gold);
        color:#0a0d16;
    }
    .product-cta:hover .arrow{ transform: translateX(4px); }

    /* ============ SECTION SHELL ============ */
    .section{
        padding:100px 20px;
        border-bottom:1px solid var(--hairline);
    }
    .section-head{
        text-align:center;
        max-width:560px;
        margin:0 auto 64px;
    }
    .section-eyebrow{
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.2em;
        text-transform:uppercase;
        color: var(--gold);
        margin-bottom:18px;
        display:block;
    }
    .section-title{
        font-family:'Fraunces', serif;
        font-weight:450;
        font-style:italic;
        font-size:clamp(28px, 3.6vw, 38px);
        color: var(--cream);
        margin-bottom:14px;
    }
    .section-sub{
        font-size:15px;
        color: var(--muted);
    }

    /* ============ HOW IT WORKS ============ */
    .steps{
        display:grid;
        grid-template-columns: repeat(3, 1fr);
        gap:1px;
        background: var(--hairline);
        border:1px solid var(--hairline);
        max-width:980px;
        margin:0 auto;
    }
    .step{
        background: var(--panel-solid);
        padding:40px 32px;
        text-align:left;
    }
    .step-num{
        font-family:'Fraunces', serif;
        font-style:italic;
        font-size:36px;
        color: var(--gold);
        margin-bottom:18px;
        line-height:1;
    }
    .step-title{
        font-family:'Fraunces', serif;
        font-size:19px;
        margin-bottom:10px;
        color: var(--cream);
    }
    .step-desc{
        font-size:13.5px;
        color: var(--muted);
        line-height:1.65;
    }

    /* ============ TESTIMONIALS ============ */
    .testimonials{
        display:grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap:1px;
        background: var(--hairline);
        border:1px solid var(--hairline);
        max-width:1000px;
        margin:0 auto;
    }
    .testimonial{
        background: var(--panel-solid);
        padding:32px 30px;
    }
    .testimonial-stars{
        color: var(--gold);
        font-size:13px;
        letter-spacing:2px;
        margin-bottom:16px;
    }
    .testimonial-quote{
        font-family:'Fraunces', serif;
        font-style:italic;
        font-size:16px;
        color: var(--cream);
        line-height:1.55;
        margin-bottom:20px;
    }
    .testimonial-author{
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.05em;
        color: var(--muted-dim);
        text-transform:uppercase;
    }
    .testimonials-note{
        text-align:center;
        font-family:'JetBrains Mono', monospace;
        font-size:10.5px;
        color: var(--muted-dim);
        margin-top:24px;
        opacity:0.7;
    }

    /* ============ FAQ ============ */
    .faq{
        max-width:760px;
        margin:0 auto;
    }
    .faq-item{
        border-bottom:1px solid var(--hairline);
    }
    .faq-question{
        width:100%;
        background:none;
        border:none;
        color: var(--cream);
        text-align:left;
        padding:24px 4px;
        font-family:'Fraunces', serif;
        font-size:18px;
        cursor:pointer;
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:20px;
    }
    .faq-icon{
        color: var(--gold);
        font-family:'JetBrains Mono', monospace;
        font-size:18px;
        flex-shrink:0;
        transition: transform 0.3s ease;
    }
    .faq-item.open .faq-icon{ transform: rotate(45deg); }
    .faq-answer{
        max-height:0;
        overflow:hidden;
        transition: max-height 0.35s ease, padding 0.35s ease;
        padding:0 4px;
    }
    .faq-item.open .faq-answer{
        max-height:300px;
        padding:0 4px 24px;
    }
    .faq-answer p{
        font-size:14.5px;
        color: var(--muted);
        line-height:1.7;
        max-width:640px;
    }

    /* ============ FOOTER ============ */
    footer{
        padding:56px 20px 48px;
        text-align:center;
    }

    .footer-guarantee{
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.06em;
        color: var(--muted-dim);
        margin-bottom:28px;
        text-transform:uppercase;
    }

    footer p{
        margin-bottom:18px;
        color: var(--muted-dim);
        font-size:13px;
        letter-spacing:0.03em;
    }

    #footerQuestion{
        font-family:'Fraunces', serif;
        font-style:italic;
        font-size:17px;
        color: var(--muted);
    }

    .social-links{
        display:flex;
        justify-content:center;
        gap:36px;
        margin-bottom:32px;
    }

    .social-links a{
        color: var(--gold-light);
        text-decoration:none;
        font-family:'JetBrains Mono', monospace;
        font-size:11px;
        letter-spacing:0.1em;
        text-transform:uppercase;
        padding-bottom:4px;
        border-bottom:1px solid transparent;
        transition: border-color 0.3s ease, color 0.3s ease;
    }
    .social-links a:hover{
        color: var(--gold);
        border-color: var(--gold-dim);
    }

    #footerCopyright{
        font-family:'JetBrains Mono', monospace;
        font-size:10px;
        letter-spacing:0.06em;
        color:#454c5e;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px){
        header{ padding:64px 20px 36px; }
        header h1{ font-size:40px; }
        .hero h2{ font-size:24px; }
        .filters{ gap:20px; }
        .products-grid{ grid-template-columns:1fr; margin:44px 0 0; }
        .product-image{ height:320px; }
        .product-content{ padding:28px 24px 26px; }
        .topbar .container{ justify-content:center; text-align:center; }
        .topbar-right{ width:100%; justify-content:center; }
        .section{ padding:64px 20px; }
        .steps{ grid-template-columns:1fr; }
        .trust-bar{ gap:18px 22px; }
    }

    @media (prefers-reduced-motion: reduce){
        *{ transition:none !important; animation:none !important; }
    }
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
    <div class="container">
        <div class="brand-mark">Hit<strong>-E-Book</strong> · Atelier Numérique</div>
        <div class="topbar-right">
            <a href="#collection" class="topbar-cta" id="topbarCta">Voir la collection</a>
            <div class="language-selector">
                <button class="language-btn active" onclick="changeLanguage('fr', this)">FR</button>
                <button class="language-btn" onclick="changeLanguage('pt', this)">PT</button>
                <button class="language-btn" onclick="changeLanguage('en', this)">EN</button>
                <button class="language-btn" onclick="changeLanguage('de', this)">DE</button>
            </div>
        </div>
    </div>
</div>

<!-- HEADER -->
<header>
    <div class="container">
        <div class="eyebrow" id="eyebrowLabel">Collection 2026</div>
        <h1>Hit<span class="gradient-text">-E-Book</span></h1>
        <p id="headerDescription">Des guides exigeants, pensés pour ceux qui refusent l'approximation.</p>
        <a href="#collection" class="header-cta" id="headerCta"><span>Découvrir la collection</span><span>→</span></a>
        <div class="trust-bar">
            <span id="trust1">Paiement 100% sécurisé</span>
            <span id="trust2">Accès immédiat après achat</span>
            <span id="trust3">Garantie 14 jours satisfait ou remboursé</span>
        </div>
    </div>
</header>

<!-- HERO + FILTERS -->
<div class="hero" id="collection">
    <div class="container">
        <h2 id="heroTitle">La Collection</h2>
        <p id="heroDescription">Chaque guide est une pièce à part entière — choisissez la vôtre.</p>

        <div class="filters">
            <button class="filter-btn active" onclick="filterProducts('all', this)" id="filterAll">Tout voir</button>
            <button class="filter-btn" onclick="filterProducts('prompts', this)" id="filterPrompts">Prompts &amp; IA</button>
            <button class="filter-btn" onclick="filterProducts('creation', this)" id="filterCreation">Création &amp; Business</button>
            <button class="filter-btn" onclick="filterProducts('copywriting', this)" id="filterCopywriting">Copywriting</button>
        </div>
    </div>
</div>

<!-- PRODUCTS GRID -->
<div class="container">
    <div class="products-grid" id="productsGrid"></div>
</div>

<!-- HOW IT WORKS -->
<section class="section">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow" id="howEyebrow">Simple &amp; direct</span>
            <h2 class="section-title" id="howTitle">Comment ça marche</h2>
        </div>
        <div class="steps" id="stepsGrid"></div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="section">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow" id="testiEyebrow">Retours</span>
            <h2 class="section-title" id="testiTitle">Ce qu'en disent les lecteurs</h2>
        </div>
        <div class="testimonials" id="testimonialsGrid"></div>
        <p class="testimonials-note" id="testiNote">— remplacez cette section par vos vrais avis clients avant publication —</p>
    </div>
